# MCP Server - this required for protected HTTP transport
MCP_SERVER_NAME=HR Leave MCP Server
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_AUTH_TOKEN=CHANGE_ME
MCP_LOG_LEVEL=INFO

# Database Configuration should be here

HR_DB_PATH=data/hr_leave.db
SEED_FILE_PATH=data/seed_employees.json

# LLM provider selection — default OpenAI
MODEL_PROVIDER=openai

# OpenAI — required when MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic — optional provider switch
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini — optional provider switch
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.5-flash

# LangSmith — optional tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=BIA_Containerising_MCP_LLM_Connect

